<odoo>


<record id="view_move_tree" model="ir.ui.view">
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_move_tree"/>
    <field name="arch" type="xml">
        <field name="product_id" position="after">
            <field name="product_use_expiry_date" invisible="1"/>
            <field name="product_expiry_min_days" optional="hide" invisible="not product_use_expiry_date"/>
        </field>
    </field>
</record>

<record id="view_picking_move_tree" model="ir.ui.view">
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_picking_move_tree" />
    <field name="arch" type="xml">
        <field name="product_id" position="after">
            <field name="product_use_expiry_date" invisible="1"/>
            <field
                    name="product_expiry_min_days"
                readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0"
                invisible="not product_use_expiry_date"
                    optional="hide"
                />
        </field>
    </field>
</record>

<record id="view_stock_move_operations" model="ir.ui.view">
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_stock_move_operations"/>
    <field name="arch" type="xml">
        <field name="product_id" position="after">
            <field name="product_use_expiry_date" invisible="1"/>
            <label for="product_expiry_min_days"
                invisible="not product_use_expiry_date"
                />
            <div invisible="not product_use_expiry_date"
                name="product_expiry_min_days">
                <field name="product_expiry_min_days" readonly="1" class="oe_inline"/> days
            </div>
        </field>
    </field>
</record>

<record id="view_move_form" model="ir.ui.view">
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_move_form"/>
    <field name="arch" type="xml">
        <group name="main_grp_col2" position="inside">
            <field name="product_use_expiry_date" invisible="1"/>
            <label for="product_expiry_min_days" invisible="not product_use_expiry_date"/>
            <div  invisible="not product_use_expiry_date" name="product_expiry_min_days">
                <field name="product_expiry_min_days" class="oe_inline"/> days
            </div>
        </group>
    </field>
</record>


</odoo>
