<odoo>

<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <block name="warehouse_setting_container" position="after">
            <block title="Deposit" name="deposit_setting_container">
                <setting id="deposit_picking_type" string="Picking Type for Hospital deposit deliveries">
                    <field name="deposit_stock_out_type_id" context="{'default_code': 'outgoing', 'default_use_create_lots': False}"/>
                </setting>
                <setting id="deposit_main_location_id" string="Parent location for deposit locations">
                    <field name="deposit_main_location_id"/>
                </setting>
            </block>
        </block>
    </field>
</record>

</odoo>
