<odoo>

    <record id="product_marketing_authorization_enable_form" model="ir.ui.view">
        <field name="model">product.marketing.authorization.enable</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="product_template_id"/>
                </group>
                <footer>
                    <button name="run" type="object" class="btn-primary" string="Enable Marketing Authorization"/>
                    <button special="cancel" string="Cancel" class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="product_marketing_authorization_enable_product_template_action" model="ir.actions.act_window">
        <field name="name">Enable Marketing Authorization</field>
        <field name="res_model">product.marketing.authorization.enable</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_view_types">form</field>
    </record>

    <record id="product_marketing_authorization_enable_product_product_action" model="ir.actions.act_window">
        <field name="name">Enable Marketing Authorization</field>
        <field name="res_model">product.marketing.authorization.enable</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product" />
        <field name="binding_view_types">form</field>
    </record>


</odoo>
